VITE_SUPABASE_URL=
VITE_SUPABASE_ANON=
VITE_SUPABASE_PROJECT_ID=
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
# Optional. Set a Google Analytics 4 measurement ID (G-...) to enable consent-gated ecommerce reporting.
VITE_GA4_MEASUREMENT_ID=
# Optional. Error monitoring stays dormant when this is empty.
# Release identity comes from VITE_APP_VERSION or the git SHA, not from here.
VITE_SENTRY_DSN=
# Never put PAYSTACK_SECRET_KEY in a VITE_ variable or client-side code.
# Keep the secret key in a server/edge function environment only.
